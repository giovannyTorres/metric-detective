# Copy to .env. Never commit credentials.
MD_DATABASE_URL=postgresql://detective:local-development-only@localhost:5432/detective
POSTGRES_PASSWORD=local-development-only
MD_DATA_DIR=runtime/datasets
MD_LLM_PROVIDER=ollama
MD_LLM_MODEL=qwen3.5:4b
MD_OLLAMA_BASE_URL=http://localhost:11434
# Optional Bearer key for a protected Ollama-compatible endpoint. No other provider implemented.
MD_LLM_API_KEY=
MD_API_URL=http://localhost:8000
MD_MAX_UPLOAD_BYTES=10485760
MD_LEASE_SECONDS=30
MD_MAX_JOB_ATTEMPTS=3
# Test DB must be a separate expendable database; never point at production.
MD_TEST_DATABASE_URL=

# Optional independent native supervisor (never registers an OS startup task).
MD_LOCAL_API_PORT=18000
MD_LOCAL_UI_PORT=18501
MD_RUNTIME_DIR=runtime/local
# Existing PostgreSQL binaries/data can be managed locally; no automatic download.
MD_POSTGRES_BIN=
MD_POSTGRES_DATA=
MD_POSTGRES_PORT=55432
MD_START_OLLAMA=false
